variant: fcos
version: 1.6.0
passwd:
  users:
    # Set SSH key for default core user
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK0/nWAS+nfgwj13kIfeIQq3UW1Bp6vrbeOCIi8dHkOU marmocc@marmo.cc"
storage:
  directories:
    # Prepare permissions for mount
    - path: /var/mnt/active
      mode: 0755
    - path: /var/mnt/archive
      mode: 0755
    # Prepare permissions for containers
    - path: /var/home/core/.config
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers/systemd
      mode: 0755
      user: { name: core }
      group: { name: core }
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true
  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION
    # Make core user linger
    - path: /var/lib/systemd/linger/core
      mode: 0644
      contents:
        inline: ""
    # Configure Internet connection
    - path: /etc/NetworkManager/system-connections/external.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=external
          type=ethernet
          interface-name=enp2s0
          [ipv4]
          method=manual
          addresses=192.168.1.100/24
          gateway=192.168.1.254
          dns=192.168.1.254
          [ipv6]
          method=disabled
    # Configure internal connection
    - path: /etc/NetworkManager/system-connections/internal.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=internal
          type=ethernet
          interface-name=enp3s0
          [ipv4]
          method=manual
          addresses=10.0.0.1/30
          [ipv6]
          method=disabled
    # Initialize example secrets file
    - path: /var/home/core/.config/containers/systemd/secrets.env.example
      mode: 0600
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          TUNNEL_TOKEN=
    # Configure container for Cloudflare Tunnel
    - path: /var/home/core/.config/containers/systemd/cloudflared.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Cloudflare Tunnel
          After=network-online.target
          ConditionPathExists=/var/home/core/.config/containers/systemd/secrets.env

          [Container]
          Image=docker.io/cloudflare/cloudflared:latest
          ContainerName=cloudflared
          EnvironmentFile=/var/home/core/.config/containers/systemd/secrets.env
          Exec=tunnel --no-autoupdate run

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure container for Netdata
    - path: /var/home/core/.config/containers/systemd/netdata.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Netdata Performance Monitor
          After=network-online.target var-mnt-active.mount
          Requires=var-mnt-active.mount
          ConditionPathExists=/var/mnt/active/netdata/config
          ConditionPathExists=/var/mnt/active/netdata/lib
          ConditionPathExists=/var/mnt/active/netdata/cache

          [Container]
          Image=docker.io/netdata/netdata:latest
          ContainerName=netdata
          Environment=NETDATA_CLAIM_TOKEN="" NETDATA_CLOUD_ENABLED="0" DISABLE_TELEMETRY="1"

          Volume=/etc/passwd:/host/etc/passwd:ro
          Volume=/etc/group:/host/etc/group:ro
          Volume=/proc:/host/proc:ro
          Volume=/sys:/host/sys:ro
          Volume=/etc/os-release:/host/etc/os-release:ro

          Volume=/var/mnt/active/netdata/config:/etc/netdata:Z
          Volume=/var/mnt/active/netdata/lib:/var/lib/netdata:Z
          Volume=/var/mnt/active/netdata/cache:/var/cache/netdata:Z

          AddCapability=SYS_PTRACE
          AddCapability=SYS_ADMIN
          SecurityLabelDisable=true

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
systemd:
  units:
    # Mount ACTIVE
    - name: var-mnt-active.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount ACTIVE
        Before=local-fs.target

        [Mount]
        What=/dev/disk/by-label/ACTIVE
        Where=/var/mnt/active
        Type=ext4
        Options=defaults

        [Install]
        WantedBy=multi-user.target
    # Mount ARCHIVE
    - name: var-mnt-archive.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount ARCHIVE
        Before=local-fs.target

        [Mount]
        What=/dev/disk/by-label/ARCHIVE
        Where=/var/mnt/archive
        Type=ext4
        Options=defaults

        [Install]
        WantedBy=multi-user.target