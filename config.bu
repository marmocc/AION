variant: fcos
version: 1.6.0
passwd:
  users:
    # Set SSH key for default core user
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ5mcen2vcOenfR6CUmHu3h+zrV4573xJMo0NMKcfXHD"
storage:
  directories:
    # Prepare permissions for mount
    - path: /var/mnt/active
      mode: 0755
    - path: /var/mnt/archive
      mode: 0755
    # Prepare permissions for containers
    - path: /var/home/core/.config
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers/systemd
      mode: 0755
      user: { name: core }
      group: { name: core }
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true
  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION
    # Configure Internet connection
    - path: /etc/NetworkManager/system-connections/external.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=external
          type=ethernet
          interface-name=enp2s0
          [ipv4]
          method=manual
          addresses=192.168.1.100/24
          gateway=192.168.1.254
          dns=192.168.1.254
          [ipv6]
          method=disabled
    # Configure internal connection
    - path: /etc/NetworkManager/system-connections/internal.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=internal
          type=ethernet
          interface-name=enp3s0
          [ipv4]
          method=manual
          addresses=10.0.0.1/30
          [ipv6]
          method=disabled
    # Configure rootless internal container network
    - path: /var/home/core/.config/containers/systemd/services.network
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Network]
          NetworkName=services-bridge
          Driver=bridge
    # Configure rootless container for Cloudflare Tunnel
    - path: /var/home/core/.config/containers/systemd/cloudflared.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Cloudflare Tunnel
          After=network-online.target services-network.service fix-active-ownership.service
          Requires=services-network.service fix-active-ownership.service

          [Container]
          Image=docker.io/cloudflare/cloudflared:latest
          ContainerName=cloudflared
          Network=services.network
          EnvironmentFile=/var/mnt/active/secrets.env
          Exec=tunnel --no-autoupdate --metrics=0.0.0.0:2000 run

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure rootless container for Beszel
    - path: /var/home/core/.config/containers/systemd/beszel.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Beszel Hub
          After=network-online.target services-network.service fix-active-ownership.service
          Requires=services-network.service fix-active-ownership.service

          [Container]
          Image=docker.io/henrygd/beszel:latest
          ContainerName=beszel
          Network=services.network
          Volume=/var/mnt/active/beszel:/beszel_data:Z

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure rootful container for Beszel Agent
    - path: /etc/containers/systemd/beszel-agent.container
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Beszel Agent
          After=network-online.target enable-core-podman-socket.service fix-active-ownership.service
          Requires=enable-core-podman-socket.service fix-active-ownership.service

          [Container]
          Image=docker.io/henrygd/beszel-agent:alpine
          ContainerName=beszel-agent
          PodmanArgs=--pid=host --privileged
          Network=host
          SecurityLabelDisable=true
          Volume=/run/user/1000/podman/podman.sock:/var/run/docker.sock:ro
          EnvironmentFile=/var/mnt/active/secrets.env

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target
    # Configure rootless container for Kopia
    - path: /var/home/core/.config/containers/systemd/kopia.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Kopia Backups
          After=network-online.target services-network.service fix-active-ownership.service fix-archive-ownership.service
          Requires=services-network.service fix-active-ownership.service fix-archive-ownership.service

          [Container]
          Image=docker.io/kopia/kopia:latest
          ContainerName=kopia
          Network=services.network
          Volume=/var/mnt/active/kopia:/app:Z
          Volume=/var/mnt/archive/kopia:/repository:Z
          Volume=/var/mnt/active:/target:Z
          EnvironmentFile=/var/mnt/active/secrets.env
          Exec=server start --insecure --address=0.0.0.0:51515

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
systemd:
  units:
    # Mount ACTIVE
    - name: var-mnt-active.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount ACTIVE
        Before=local-fs.target

        [Mount]
        What=/dev/disk/by-label/ACTIVE
        Where=/var/mnt/active
        Type=ext4
        Options=defaults

        [Install]
        WantedBy=multi-user.target
    # Fix ACTIVE ownership
    - name: fix-active-ownership.service
      enabled: true
      contents: |
        [Unit]
        Description=Fix ACTIVE ownership for core user
        After=var-mnt-active.mount
        Requires=var-mnt-active.mount

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/chown core:core /var/mnt/active
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
    # Mount ARCHIVE
    - name: var-mnt-archive.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount ARCHIVE
        Before=local-fs.target

        [Mount]
        What=/dev/disk/by-label/ARCHIVE
        Where=/var/mnt/archive
        Type=ext4
        Options=defaults

        [Install]
        WantedBy=multi-user.target
    # Fix ARCHIVE ownership
    - name: fix-archive-ownership.service
      enabled: true
      contents: |
        [Unit]
        Description=Fix ARCHIVE ownership for core user
        After=var-mnt-archive.mount
        Requires=var-mnt-archive.mount

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/chown core:core /var/mnt/archive
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
    # Enable linger for core user
    - name: enable-core-linger.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable Linger for core user
        After=systemd-logind.service passwd.target

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/loginctl enable-linger core
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
    # Enable Podman socket for core user
    - name: enable-core-podman-socket.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable Podman socket for core user
        After=enable-core-linger.service
        Requires=enable-core-linger.service

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/systemctl --user -M core@ enable --now podman.socket
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target