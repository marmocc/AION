variant: fcos
version: 1.6.0
passwd:
  users:
    # Set SSH key for default core user
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ5mcen2vcOenfR6CUmHu3h+zrV4573xJMo0NMKcfXHD"
storage:
  directories:
    # Prepare permissions for mount
    - path: /var/mnt/data
      mode: 0755
    # Prepare permission for core config
    - path: /var/home/core/.config
      mode: 0755
      user: { name: core }
      group: { name: core }
    # Prepare permissions for core containers
    - path: /var/home/core/.config/containers
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers/systemd
      mode: 0755
      user: { name: core }
      group: { name: core }
    # Prepare permission for core units
    - path: /var/home/core/.config/systemd
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/systemd/user
      mode: 0755
      user: { name: core }
      group: { name: core }
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true
    # Enable core's podman socket
    - path: /var/home/core/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user: { name: core }
      group: { name: core }
  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION
    # Enable linger for default core user
    - path: /var/lib/systemd/linger/core
      mode: 0644
    # Fix mount permissions
    - path: /etc/tmpfiles.d/fix-mount-permissions.conf
      mode: 0644
      contents:
        inline: |
          # Path            Mode User Group Age Argument
          d /var/mnt/data  0755 core core - -
    # Configure Internet connection
    - path: /etc/NetworkManager/system-connections/external.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=external
          type=ethernet
          interface-name=enp2s0
          [ipv4]
          method=manual
          addresses=192.168.1.100/24
          gateway=192.168.1.254
          dns=192.168.1.254
          [ipv6]
          method=disabled
    # Configure internal connection
    - path: /etc/NetworkManager/system-connections/internal.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=internal
          type=ethernet
          interface-name=enp3s0
          [ipv4]
          method=manual
          addresses=10.0.0.1/30
          [ipv6]
          method=disabled
    # Configure rootless internal container network
    - path: /var/home/core/.config/containers/systemd/services.network
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Network]
          NetworkName=services-bridge
          Driver=bridge
    # Configure rootless container for Cloudflare Tunnel
    - path: /var/home/core/.config/containers/systemd/cloudflared.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Cloudflare Tunnel
          After=network-online.target services-network.service
          Requires=services-network.service

          [Container]
          Image=docker.io/cloudflare/cloudflared:latest
          ContainerName=cloudflared
          Hostname=cloudflared
          Network=services.network
          Secret=cloudflared_tunnel_token,type=env,target=TUNNEL_TOKEN
          Exec=tunnel --no-autoupdate --metrics=0.0.0.0:2000 run

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure rootless container for Kopia
    - path: /var/home/core/.config/containers/systemd/kopia.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Kopia Backups
          After=network-online.target services-network.service var-mnt-data.mount
          Requires=services-network.service var-mnt-data.mount

          [Container]
          Image=docker.io/kopia/kopia:latest
          ContainerName=kopia
          Hostname=kopia
          Network=services.network
          Volume=kopia_data:/app:Z
          Volume=/var/mnt/data/kopia:/repository:Z

          Secret=kopia_repo_password,type=env,target=KOPIA_PASSWORD
          Secret=kopia_ui_password,type=env,target=KOPIA_UI_PASSWORD
          Environment=KOPIA_UI_USERNAME=marmocc
          Exec=server start --insecure --address=0.0.0.0:51515

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure rootless container for Syncthing
    - path: /var/home/core/.config/containers/systemd/syncthing.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Syncthing
          After=network-online.target services-network.service var-mnt-data.mount
          Requires=services-network.service var-mnt-data.mount

          [Container]
          Image=docker.io/syncthing/syncthing:latest
          ContainerName=syncthing
          Hostname=syncthing
          Network=services.network
          Volume=/var/mnt/data/syncthing:/var/syncthing:Z

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
systemd:
  units:
    # Mount data
    - name: var-mnt-data.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount data
        Before=local-fs.target

        [Mount]
        What=UUID=0047719d-a4a3-4455-a7fa-a697f7daab8c
        Where=/var/mnt/data
        Type=btrfs
        Options=defaults,x-systemd.device-timeout=30s

        [Install]
        WantedBy=multi-user.target