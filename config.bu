variant: fcos
version: 1.6.0
passwd:
  users:
    # Set SSH key for default core user
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ5mcen2vcOenfR6CUmHu3h+zrV4573xJMo0NMKcfXHD"
storage:
  directories:
    # Prepare permissions for mount
    - path: /var/mnt/wd_blue_1tb
      mode: 0755
    # Prepare permission for core config
    - path: /var/home/core/.config
      mode: 0755
      user: { name: core }
      group: { name: core }
    # Prepare permissions for core containers
    - path: /var/home/core/.config/containers
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers/systemd
      mode: 0755
      user: { name: core }
      group: { name: core }
    # Prepare permission for core units
    - path: /var/home/core/.config/systemd
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/systemd/user
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/systemd/user/sockets.target.wants
      mode: 0755
      user: { name: core }
      group: { name: core }
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true
    # Enable core's podman socket
    - path: /var/home/core/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user: { name: core }
      group: { name: core }
  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION
    # Enable linger for default core user
    - path: /var/lib/systemd/linger/core
      mode: 0644
    # Fix mount permissions
    - path: /etc/tmpfiles.d/fix-mount-permissions.conf
      mode: 0644
      contents:
        inline: |
          # Path            Mode User Group Age Argument
          d /var/mnt/wd_blue_1tb  0755 core core - -
    # Configure Internet connection
    - path: /etc/NetworkManager/system-connections/external.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=external
          type=ethernet
          interface-name=enp2s0
          [ipv4]
          method=manual
          addresses=192.168.1.100/24
          gateway=192.168.1.254
          dns=192.168.1.254
          [ipv6]
          method=disabled
    # Configure internal connection
    - path: /etc/NetworkManager/system-connections/internal.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=internal
          type=ethernet
          interface-name=enp3s0
          [ipv4]
          method=manual
          addresses=10.0.0.1/30
          [ipv6]
          method=disabled
    # Embed AION TLS certificate
    - path: /var/home/core/AION.crt
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        local: AION.crt
    # Configure rootless internal container network
    - path: /var/home/core/.config/containers/systemd/services.network
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Network]
          NetworkName=services-bridge
          Driver=bridge
    # Configure rootless container for Cloudflare Tunnel
    - path: /var/home/core/.config/containers/systemd/cloudflared.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Cloudflare Tunnel
          After=network-online.target services-network.service
          Requires=services-network.service

          [Container]
          Image=docker.io/cloudflare/cloudflared:latest
          ContainerName=cloudflared
          Network=services.network
          Secret=cloudflared_tunnel_token,type=env,target=TUNNEL_TOKEN
          Exec=tunnel --no-autoupdate --metrics=0.0.0.0:2000 run

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure rootless container for Beszel
    - path: /var/home/core/.config/containers/systemd/beszel.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Beszel Hub
          After=network-online.target services-network.service
          Requires=services-network.service

          [Container]
          Image=docker.io/henrygd/beszel:latest
          ContainerName=beszel
          Network=services.network
          Volume=/var/home/core/beszel:/beszel_data:Z

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure rootful container for Beszel Agent
    - path: /etc/containers/systemd/beszel-agent.container
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Beszel Agent
          After=network-online.target

          [Container]
          Image=docker.io/henrygd/beszel-agent:alpine
          ContainerName=beszel-agent
          PodmanArgs=--pid=host --privileged
          Network=host
          SecurityLabelDisable=true
          Volume=/run/user/1000/podman/podman.sock:/var/run/docker.sock:ro
          Secret=beszel_agent_ssh_key,type=env,target=KEY

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target
    # Configure rootless container for Kopia
    - path: /var/home/core/.config/containers/systemd/kopia.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Kopia Server
          After=network-online.target services-network.service var-mnt-wd_blue_1tb.mount
          Requires=services-network.service var-mnt-wd_blue_1tb.mount

          [Container]
          Image=docker.io/kopia/kopia:latest
          ContainerName=kopia
          Network=services.network
          PublishPort=10.0.0.1:51515:51515

          Volume=/var/mnt/wd_blue_1tb/kopia:/repository:Z
          Environment=KOPIA_SERVER_USERNAME=marmocc
          Secret=kopia_server_password,type=env,target=KOPIA_SERVER_PASSWORD

          Volume=/var/home/core/AION.crt:/tls/AION.crt:ro,Z
          Secret=aion_tls_key,type=mount,target=/tls/AION.key

          Exec=server start \
              --tls-cert-file=/tls/AION.crt \
              --tls-key-file=/tls/AION.key \
              --address=0.0.0.0:51515

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure rootless container for FileBrowser Quantum
    - path: /var/home/core/.config/containers/systemd/filebrowser.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=FileBrowser Quantum
          After=network-online.target services-network.service var-mnt-wd_blue_1tb.mount
          Requires=services-network.service var-mnt-wd_blue_1tb.mount

          [Container]
          Image=docker.io/gtstef/filebrowser:latest
          ContainerName=filebrowser
          Network=services.network
          PublishPort=10.0.0.1:8080:80
          PodmanArgs=--user 0:0

          Volume=/var/home/core/filebrowser:/home/filebrowser/data:Z
          Volume=/var/mnt/wd_blue_1tb:/wd_blue_1tb:Z
          Secret=filebrowser_admin_password,type=env,target=FILEBROWSER_ADMIN_PASSWORD

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
systemd:
  units:
    # Mount data
    - name: var-mnt-wd_blue_1tb.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount wd_blue_1tb
        Before=local-fs.target

        [Mount]
        What=UUID=0047719d-a4a3-4455-a7fa-a697f7daab8c
        Where=/var/mnt/wd_blue_1tb
        Type=btrfs
        Options=defaults,x-systemd.device-timeout=30s

        [Install]
        WantedBy=multi-user.target