variant: fcos
version: 1.7.0
passwd:
  groups:
    - name: sftponly
  users:
    # Set SSH key for default core user
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHgdSqPX/ytQO+aMCPlUMciHLeVHqWxASkMeYO0nBsfe"
    # Set SSH key for SFTP marmocc user
    - name: marmocc
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOqh6I0SmpVtiFYXxouabQdLYdZl6ShFJbFV3eFLtJNm"
      groups: 
        - sftponly
      home_dir: /var/mnt/data/marmocc
      shell: /sbin/nologin
storage:
  filesystems:
    - path: /var/mnt/data
      device: /dev/disk/by-label/DISK1
      format: ext4
      wipe_filesystem: false
      with_mount_unit: true
  directories:
    # Prepare directory for Beszel data
    - path: /var/home/core/beszel
      mode: 0755
      user: { name: core }
      group: { name: core }
    # Prepare directory for Filestash data
    - path: /var/home/core/filestash
      mode: 0755
      user: { name: core }
      group: { name: core }
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true
  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION
    # Enable linger for default core user
    - path: /var/lib/systemd/linger/core
      mode: 0644
    # Configure OpenSSH server for SFTP
    - path: /etc/ssh/sshd_config.d/02-sftponly.conf
      mode: 0600
      contents:
        inline: |
          Match Group sftponly
            ChrootDirectory /var/mnt/data
            PermitTTY no
            X11Forwarding no
            AllowAgentForwarding no
            AllowTcpForwarding no
            ForceCommand internal-sftp -f AUTHPRIV -l VERBOSE -d /%u
    # Configure rootless Quadlets
    - path: /etc/containers/systemd/users/1000/services.network
      mode: 0644
      contents:
        local: quadlets/services.network
    - path: /etc/containers/systemd/users/1000/cloudflared.container
      mode: 0644
      contents:
        local: quadlets/cloudflared.container
    - path: /etc/containers/systemd/users/1000/beszel.container
      mode: 0644
      contents:
        local: quadlets/beszel.container
    - path: /etc/containers/systemd/users/1000/filestash.container
      mode: 0644
      contents:
        local: quadlets/filestash.container
    # Configure rootful Quadlets
    - path: /etc/containers/systemd/beszel-agent.container
      mode: 0644
      contents:
        local: quadlets/beszel-agent.container
    - path: /etc/containers/systemd/kopia.container
      mode: 0644
      contents:
        local: quadlets/kopia.container
systemd:
  units:
    # Schedule backup with Kopia
    - name: kopia.timer
      enabled: true
      contents: |
        [Unit]
        Description=Daily Kopia Backup
        Requires=kopia.service

        [Timer]
        OnCalendar=daily
        OnCalendar=*-*-* 02:00:00
        AccuracySec=1m
        Persistent=true

        [Install]
        WantedBy=timers.target