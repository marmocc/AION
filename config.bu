variant: fcos
version: 1.7.0
passwd:
  users:
    # Set SSH key for default core user
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHgdSqPX/ytQO+aMCPlUMciHLeVHqWxASkMeYO0nBsfe"
    # Set SSH key for SFTP marmocc user
    - name: marmocc
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOqh6I0SmpVtiFYXxouabQdLYdZl6ShFJbFV3eFLtJNm"
      home_dir: /var/mnt/data/marmocc
      shell: /sbin/nologin
storage:
  filesystems:
    - path: /var/mnt/data
      device: /dev/disk/by-label/DISK1
      format: ext4
      wipe_filesystem: false
      with_mount_unit: true
  directories:
    # Prepare directory for Beszel data
    - path: /var/home/core/beszel
      mode: 0755
      user: { name: core }
      group: { name: core }
    # Prepare directory for Filestash data
    - path: /var/home/core/filestash
      mode: 0755
      user: { name: core }
      group: { name: core }
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true
  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        local: configs/hostname
    # Enable linger for default core user
    - path: /var/lib/systemd/linger/core
      mode: 0644
    # Fix mount permissions
    - path: /etc/tmpfiles.d/fix-mount-permissions.conf
      mode: 0644
      contents:
        local: configs/fix-mount-permissions.conf
    # Configure OpenSSH server for SFTP
    - path: /etc/ssh/sshd_config.d/02-sftp-chroot.conf
      mode: 0600
      contents:
        local: configs/02-sftp-chroot.conf
    # Configure Quadlets
    - path: /etc/containers/systemd/users/services.network
      mode: 0644
      contents:
        local: quadlets/services.network
    - path: /etc/containers/systemd/users/cloudflared.container
      mode: 0644
      contents:
        local: quadlets/cloudflared.container
    - path: /etc/containers/systemd/users/beszel.container
      mode: 0644
      contents:
        local: quadlets/beszel.container
    - path: /etc/containers/systemd/users/filestash.container
      mode: 0644
      contents:
        local: quadlets/filestash.container
    - path: /etc/containers/systemd/beszel-agent.container
      mode: 0644
      contents:
        local: quadlets/beszel-agent.container
    - path: /etc/containers/systemd/kopia.container
      mode: 0644
      contents:
        local: quadlets/kopia.container
systemd:
  units:
    # Schedule backup with Kopia
    - name: kopia.timer
      enabled: true
      contents_local: units/kopia.timer