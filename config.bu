variant: fcos
version: 1.6.0
passwd:
  users:
    # Create services user for rootless containers
    - name: services
      shell: /usr/sbin/nologin

    # Create administrator user
    - name: marmocc
      groups: [ sudo, wheel ]
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK0/nWAS+nfgwj13kIfeIQq3UW1Bp6vrbeOCIi8dHkOU marmocc@marmo.cc"

storage:
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true

  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION

    # Enable linger for services user
    - path: /var/lib/systemd/linger/services
      mode: 0644
      contents:
        inline: ""

    # Configure the Internet connection
    - path: /etc/NetworkManager/system-connections/external.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=external
          type=ethernet
          interface-name=enp2s0

          [ipv4]
          method=manual
          addresses=192.168.1.100/24
          gateway=192.168.1.254
          dns=192.168.1.254

          [ipv6]
          method=disabled

    # Configure the direct connection
    - path: /etc/NetworkManager/system-connections/internal.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=internal
          type=ethernet
          interface-name=enp3s0

          [ipv4]
          method=manual
          addresses=10.0.0.1/30

          [ipv6]
          method=disabled

  directories:
    # Prepare permissions for tree
    - path: /var/home/services
      mode: 0755
      user: { name: services }
      group: { name: services }
    - path: /var/home/services/.config
      mode: 0755
      user: { name: services }
      group: { name: services }
    - path: /var/home/services/.config/containers
      mode: 0755
      user: { name: services }
      group: { name: services }
    - path: /var/home/services/.config/containers/systemd
      mode: 0755
      user: { name: services }
      group: { name: services }

  trees:
    # Configure containers
    - local: quadlets
      path: /var/home/services/.config/containers/systemd