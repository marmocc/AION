variant: fcos
version: 1.6.0
passwd:
  users:
    # Set SSH key for default core user
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK0/nWAS+nfgwj13kIfeIQq3UW1Bp6vrbeOCIi8dHkOU marmocc@marmo.cc"
storage:
  directories:
    # Prepare permissions for mount
    - path: /var/mnt/active
      mode: 0755
    - path: /var/mnt/archive
      mode: 0755
    # Prepare permissions for containers
    - path: /var/home/core/.config
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers/systemd
      mode: 0755
      user: { name: core }
      group: { name: core }
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true
  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION
    # Make core user linger
    - path: /var/lib/systemd/linger/core
      mode: 0644
      contents:
        inline: ""
    # Configure Internet connection
    - path: /etc/NetworkManager/system-connections/external.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=external
          type=ethernet
          interface-name=enp2s0
          [ipv4]
          method=manual
          addresses=192.168.1.100/24
          gateway=192.168.1.254
          dns=192.168.1.254
          [ipv6]
          method=disabled
    # Configure internal connection
    - path: /etc/NetworkManager/system-connections/internal.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=internal
          type=ethernet
          interface-name=enp3s0
          [ipv4]
          method=manual
          addresses=10.0.0.1/30
          [ipv6]
          method=disabled
    # Configure internal container network
    - path: /var/home/core/.config/containers/systemd/services.network
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Network]
          NetworkName=services-bridge
          Driver=bridge
    # Configure container for Cloudflare Tunnel
    - path: /var/home/core/.config/containers/systemd/cloudflared.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Cloudflare Tunnel
          After=network-online.target
          ConditionPathExists=/var/mnt/active/secrets.env

          [Container]
          Image=docker.io/cloudflare/cloudflared:latest
          ContainerName=cloudflared
          Network=services.network
          EnvironmentFile=/var/mnt/active/secrets.env
          Exec=tunnel --no-autoupdate run

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure Beszel Agent
    - path: /var/home/core/.config/containers/systemd/beszel-agent.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Beszel Monitoring Agent
          After=network-online.target
          ConditionPathExists=/var/mnt/active/secrets.env

          [Container]
          Image=docker.io/henrygd/beszel-agent:latest
          ContainerName=beszel-agent
          Network=services.network
          Volume=/proc:/host/proc:ro
          EnvironmentFile=/var/mnt/active/secrets.env
          Environment=PORT=4567

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    # Configure Beszel Hub
    - path: /var/home/core/.config/containers/systemd/beszel-hub.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Beszel Dashboard Hub
          After=network-online.target var-mnt-active.mount
          Requires=var-mnt-active.mount
          ConditionPathExists=/var/mnt/active/beszel

          [Container]
          Image=docker.io/henrygd/beszel:latest
          ContainerName=beszel-hub
          Network=services.network
          Volume=/var/mnt/active/beszel:/app/beszel_data:Z

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
systemd:
  units:
    # Mount ACTIVE
    - name: var-mnt-active.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount ACTIVE
        Before=local-fs.target

        [Mount]
        What=/dev/disk/by-label/ACTIVE
        Where=/var/mnt/active
        Type=ext4
        Options=defaults

        [Install]
        WantedBy=multi-user.target
    # Mount ARCHIVE
    - name: var-mnt-archive.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount ARCHIVE
        Before=local-fs.target

        [Mount]
        What=/dev/disk/by-label/ARCHIVE
        Where=/var/mnt/archive
        Type=ext4
        Options=defaults

        [Install]
        WantedBy=multi-user.target