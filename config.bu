variant: fcos
version: 1.6.0
passwd:
  users:
    # Create services user for rootless containers
    - name: services
      system: true
      shell: /usr/sbin/nologin

    # Create administrator user
    - name: marmocc
      groups: [ sudo, wheel ]
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK0/nWAS+nfgwj13kIfeIQq3UW1Bp6vrbeOCIi8dHkOU marmocc@marmo.cc"

storage:
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true

  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION

    # Enable linger for services user
    - path: /var/lib/systemd/linger/services
      mode: 0644
      contents:
        inline: ""
  
  directories:
    # Prepare permissions for tree
    - path: /var/home/services
      mode: 0755
      user: services
      group: services

  trees:
    # Configure networks
    - local: networks
      path: /etc/NetworkManager/system-connections
      mode: 0600
    # Configure containers
    - local: quadlets
      path: /var/home/services/.config/containers/systemd
      user: services
      group: services