variant: fcos
version: 1.6.0
passwd:
  users:
    # Set SSH key for default core user
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ5mcen2vcOenfR6CUmHu3h+zrV4573xJMo0NMKcfXHD"
storage:
  directories:
    # Prepare permissions for mount
    - path: /var/mnt/wd_blue_1tb
      mode: 0755
    # Prepare permission for core config
    - path: /var/home/core/.config
      mode: 0755
      user: { name: core }
      group: { name: core }
    # Prepare permissions for core containers
    - path: /var/home/core/.config/containers
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/containers/systemd
      mode: 0755
      user: { name: core }
      group: { name: core }
    # Prepare permission for core units
    - path: /var/home/core/.config/systemd
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/systemd/user
      mode: 0755
      user: { name: core }
      group: { name: core }
    - path: /var/home/core/.config/systemd/user/sockets.target.wants
      mode: 0755
      user: { name: core }
      group: { name: core }
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true
    # Enable core's podman socket
    - path: /var/home/core/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user: { name: core }
      group: { name: core }
  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION
    # Enable linger for default core user
    - path: /var/lib/systemd/linger/core
      mode: 0644
    # Fix mount permissions
    - path: /etc/tmpfiles.d/fix-mount-permissions.conf
      mode: 0644
      contents:
        inline: |
          # Path            Mode User Group Age Argument
          d /var/mnt/wd_blue_1tb  0755 core core - -
    # Embed AION TLS certificate
    - path: /var/home/core/AION.crt
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        local: AION.crt
    # Configure rootless internal container network
    - path: /var/home/core/.config/containers/systemd/services.network
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        inline: |
          [Network]
          NetworkName=services-bridge
          Driver=bridge
    # Configure rootless container for Cloudflare Tunnel
    - path: /var/home/core/.config/containers/systemd/cloudflared.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        local: quadlets/cloudflared.container
    # Configure rootless container for Beszel
    - path: /var/home/core/.config/containers/systemd/beszel.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        local: quadlets/beszel.container
    # Configure rootful container for Beszel Agent
    - path: /etc/containers/systemd/beszel-agent.container
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/beszel-agent.container
    # Configure rootless container for Kopia
    - path: /var/home/core/.config/containers/systemd/kopia.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        local: quadlets/kopia.container
    # Configure rootless container for FileBrowser Quantum
    - path: /var/home/core/.config/containers/systemd/filebrowser.container
      mode: 0644
      user: { name: core }
      group: { name: core }
      overwrite: true
      contents:
        local: quadlets/filebrowser.container
systemd:
  units:
    # Mount data
    - name: var-mnt-wd_blue_1tb.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount wd_blue_1tb
        Before=local-fs.target

        [Mount]
        What=UUID=0047719d-a4a3-4455-a7fa-a697f7daab8c
        Where=/var/mnt/wd_blue_1tb
        Type=btrfs
        Options=defaults,x-systemd.device-timeout=30s

        [Install]
        WantedBy=multi-user.target