variant: fcos
version: 1.6.0
passwd:
  users:
    - name: marmocc
      groups: [ sudo, wheel ]
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK0/nWAS+nfgwj13kIfeIQq3UW1Bp6vrbeOCIi8dHkOU marmocc@marmo.cc"

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION

    - path: /etc/localtime
      mode: 0644
      overwrite: true
      target: ../usr/share/zoneinfo/Europe/Rome

    - path: /etc/NetworkManager/system-connections/direct.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=direct
          type=ethernet
          interface-name=enp3s0

          [ipv4]
          method=manual
          addresses=10.0.0.1/30

          [ipv6]
          method=disabled

    - path: /etc/NetworkManager/system-connections/internal.nmconnection
      mode: 0600
      overwrite: true
      contents:
        inline: |
          [connection]
          id=internal
          type=ethernet
          interface-name=enp2s0

          [ipv4]
          method=manual
          addresses=192.168.1.100/24
          gateway=192.168.1.254
          dns=192.168.1.254

          [ipv6]
          method=disabled