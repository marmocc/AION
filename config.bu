variant: fcos
version: 1.6.0
passwd:
  users:
    # Create services user for rootless containers
    - name: services
      shell: /usr/sbin/nologin

    # Create administrator user
    - name: marmocc
      groups: [ sudo, wheel ]
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK0/nWAS+nfgwj13kIfeIQq3UW1Bp6vrbeOCIi8dHkOU marmocc@marmo.cc"

storage:
  links:
    # Set the local timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Rome
      overwrite: true

  files:
    # Set the hostname
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: AION

    # Enable linger for services user
    - path: /var/lib/systemd/linger/services
      mode: 0644
      contents:
        inline: ""

  directories:
    # Prepare permissions for mount
    - path: /mnt/active
      mode: 0755
    - path: /mnt/archive
      mode: 0755
    # Prepare permissions for tree
    - path: /var/home/services
      mode: 0755
      user: { name: services }
      group: { name: services }
    - path: /var/home/services/.config
      mode: 0755
      user: { name: services }
      group: { name: services }
    - path: /var/home/services/.config/containers
      mode: 0755
      user: { name: services }
      group: { name: services }
    - path: /var/home/services/.config/containers/systemd
      mode: 0755
      user: { name: services }
      group: { name: services }

  trees:
    # Configure containers
    - local: quadlets
      path: /var/home/services/.config/containers/systemd

systemd:
  units:
    # Mount ACTIVE
    - name: mnt-active.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount ACTIVE
        After=local-fs.target

        [Mount]
        What=/dev/disk/by-label/ACTIVE
        Where=/mnt/active
        Type=ext4
        Options=defaults

        [Install]
        WantedBy=multi-user.target

    # Mount ARCHIVE
    - name: mnt-archive.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount ARCHIVE
        After=local-fs.target

        [Mount]
        What=/dev/disk/by-label/ARCHIVE
        Where=/mnt/archive
        Type=ext4
        Options=defaults

        [Install]
        WantedBy=multi-user.target