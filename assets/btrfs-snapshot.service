[Unit]
Description=BTRFS snapshots of /var/mnt/data
After=var-mnt-data.mount
Requires=var-mnt-data.mount

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c '[ -d /var/mnt/data/.snapshots ] || btrfs subvolume create /var/mnt/data/.snapshots'
ExecStart=/bin/sh -c '\
  prev=$(cat /var/mnt/data/.snapshots/.last-gen 2>/dev/null || echo 0); \
  changes=$(btrfs subvolume find-new /var/mnt/data "$prev" | grep -v "^transid marker"); \
  if [ -z "$changes" ]; then \
    echo "No changes since last snapshot ($prev), skipping"; \
    exit 0; \
  fi; \
  cur=$(btrfs subvolume show /var/mnt/data | awk -F": *" "/^[[:space:]]*Generation:/{print \$2}"); \
  btrfs subvolume snapshot -r /var/mnt/data /var/mnt/data/.snapshots/$(date +%%Y%%m%%d-%%H%%M); \
  echo "$cur" > /var/mnt/data/.snapshots/.last-gen'
ExecStart=/bin/sh -c 'ls -1 /var/mnt/data/.snapshots | grep -E "^[0-9]{8}-[0-9]{4}$" | sort -r | tail -n +11 | sed "s|^|/var/mnt/data/.snapshots/|" | xargs -r btrfs subvolume delete'